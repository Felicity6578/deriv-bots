<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable type="" id="v_stake">stake</variable>
    <variable type="" id="v_base">base_stake</variable>
    <variable type="" id="v_marti">marti_multiplier</variable>
    <variable type="" id="v_loss">loss_streak</variable>
    <variable type="" id="v_even">is_even</variable>
  </variables>
  
  <!-- GREY TAB - THIS IS THE FIX -->
  <block type="trade" id="1" x="0" y="0">
    <statement name="SUBMARKET">
      <block type="market" id="2">
        <field name="MARKET_LIST">synthetic_indices</field>
        <field name="SUBMARKET_LIST">continuous_indices</field>
        <field name="SYMBOL_LIST">R_100</field>
        <field name="TRADETYPECAT_LIST">digits</field>
        <field name="TRADETYPE_LIST">evenodd</field>
        <field name="TYPE_LIST">both</field>
        <field name="CANDLEINTERVAL_LIST">60</field>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="PAYOUTTYPE_LIST">stake</field>
        <field name="CURRENCY_LIST">USD</field>
        <field name="RESTARTONERROR">TRUE</field>
        <value name="DURATION">
          <block type="math_number" id="3"><field name="NUM">1</field></block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="4"><field name="VAR" id="v_stake">stake</field></block>
        </value>
      </block>
    </statement>
    
    <statement name="INITIALIZATION">
      <block type="variables_set" id="10"><field name="VAR" id="v_base">base_stake</field>
        <value name="VALUE"><block type="math_number" id="11"><field name="NUM">1</field></block></value>
        <next><block type="variables_set" id="12"><field name="VAR" id="v_marti">marti_multiplier</field>
          <value name="VALUE"><block type="math_number" id="13"><field name="NUM">2.5</field></block></value>
          <next><block type="variables_set" id="14"><field name="VAR" id="v_stake">stake</field>
            <value name="VALUE"><block type="variables_get" id="15"><field name="VAR" id="v_base">base_stake</field></block></value>
            <next><block type="variables_set" id="16"><field name="VAR" id="v_loss">loss_streak</field>
              <value name="VALUE"><block type="math_number" id="17"><field name="NUM">0</field></block></value>
              <next><block type="variables_set" id="18"><field name="VAR" id="v_even">is_even</field>
                <value name="VALUE"><block type="logic_boolean" id="19"><field name="BOOL">TRUE</field></block></value>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <next><block type="trade_again" id="20"></block></next>
  </block>

  <block type="before_purchase" id="30" x="0" y="400">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="31"><mutation else="1"></mutation>
        <value name="IF0"><block type="variables_get" id="32"><field name="VAR" id="v_even">is_even</field></block></value>
        <statement name="DO0"><block type="purchase" id="33"><field name="PURCHASE_TYPE">DIGITEVEN</field></block></statement>
        <statement name="ELSE"><block type="purchase" id="34"><field name="PURCHASE_TYPE">DIGITODD</field></block></statement>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="40" x="0" y="700">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="41"><mutation else="1"></mutation>
        <value name="IF0"><block type="logic_compare" id="42"><field name="OP">GT</field>
          <value name="A"><block type="contract_details" id="43"><field name="DETAIL">profit</field></block></value>
          <value name="B"><block type="math_number" id="44"><field name="NUM">0</field></block></value>
        </block></value>
        <statement name="DO0">
          <block type="variables_set" id="45"><field name="VAR" id="v_loss">loss_streak</field><value name="VALUE"><block type="math_number" id="46"><field name="NUM">0</field></block></value>
            <next><block type="variables_set" id="47"><field name="VAR" id="v_stake">stake</field><value name="VALUE"><block type="variables_get" id="48"><field name="VAR" id="v_base">base_stake</field></block></value></block>
          </next></block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="49"><field name="VAR" id="v_loss">loss_streak</field>
            <value name="VALUE"><block type="math_arithmetic" id="50"><field name="OP">ADD</field>
              <value name="A"><block type="variables_get" id="51"><field name="VAR" id="v_loss">loss_streak</field></block></value>
              <value name="B"><block type="math_number" id="52"><field name="NUM">1</field></block></value>
            </block></value>
            <next><block type="controls_if" id="53"><mutation else="1"></mutation>
              <value name="IF0"><block type="logic_compare" id="54"><field name="OP">GTE</field>
                <value name="A"><block type="variables_get" id="55"><field name="VAR" id="v_loss">loss_streak</field></block></value>
                <value name="B"><block type="math_number" id="56"><field name="NUM">2</field></block></value>
              </block></value>
              <statement name="DO0"><block type="variables_set" id="57"><field name="VAR" id="v_even">is_even</field>
                <value name="VALUE"><block type="logic_negate" id="58"><value name="BOOL"><block type="variables_get" id="59"><field name="VAR" id="v_even">is_even</field></block></value></block></value>
                <next><block type="variables_set" id="60"><field name="VAR" id="v_loss">loss_streak</field><value name="VALUE"><block type="math_number" id="61"><field name="NUM">0</field></block></value></block></next>
              </block></statement>
              <statement name="ELSE"><block type="variables_set" id="62"><field name="VAR" id="v_stake">stake</field>
                <value name="VALUE"><block type="math_arithmetic" id="63"><field name="OP">MULTIPLY</field>
                  <value name="A"><block type="variables_get" id="64"><field name="VAR" id="v_stake">stake</field></block></value>
                  <value name="B"><block type="variables_get" id="65"><field name="VAR" id="v_marti">marti_multiplier</field></block></value>
                </block></value>
              </block></statement>
            </block></next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
