<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable id="s1">Stake per side</variable>
    <variable id="d1">Duration (even ticks)</variable>
    <variable id="st">RF STEP PRO Status</variable>
    <variable id="tc">Trade Cycle</variable>
    <variable id="a1">Analysis Card 1</variable>
    <variable id="a2">Analysis Card 2</variable>
    <variable id="a3">Analysis Card 3</variable>
  </variables>
  <block type="trade" id="9001" x="14" y="14">
    <statement name="SUBMARKET">
      <block type="market" id="9002">
        <field name="MARKET_LIST">synthetic_indices</field>
        <field name="SUBMARKET_LIST">continuous_indices</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <field name="TRADETYPECAT_LIST">callput</field>
        <field name="TRADETYPE_LIST">risefall</field>
        <field name="TYPE_LIST">both</field>
        <field name="CANDLEINTERVAL_LIST">60</field>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="PAYOUTTYPE_LIST">stake</field>
        <field name="CURRENCY_LIST">USD</field>
        <field name="RESTARTONERROR">TRUE</field>
        <value name="DURATION"><block type="variables_get" id="9003"><field name="VAR" id="d1">Duration (even ticks)</field></block></value>
        <value name="AMOUNT"><block type="variables_get" id="9004"><field name="VAR" id="s1">Stake per side</field></block></value>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="9010"><field name="VAR" id="s1">Stake per side</field><value name="VALUE"><block type="math_number" id="9011"><field name="NUM">1</field></block></value>
        <next><block type="variables_set" id="9012"><field name="VAR" id="d1">Duration (even ticks)</field><value name="VALUE"><block type="math_number" id="9013"><field name="NUM">2</field></block></value>
          <next><block type="variables_set" id="9014"><field name="VAR" id="st">RF STEP PRO Status</field><value name="VALUE"><block type="text" id="9015"><field name="TEXT">READY - STEP INDEX / RISE + FALL</field></block></value>
            <next><block type="variables_set" id="9016"><field name="VAR" id="tc">Trade Cycle</field><value name="VALUE"><block type="math_number" id="9017"><field name="NUM">0</field></block></value>
              <next><block type="variables_set" id="9018"><field name="VAR" id="a1">Analysis Card 1</field><value name="VALUE"><block type="text" id="9019"><field name="TEXT">STEP INDEX FILTER: ACTIVE</field></block></value>
                <next><block type="variables_set" id="9020"><field name="VAR" id="a2">Analysis Card 2</field><value name="VALUE"><block type="text" id="9021"><field name="TEXT">PAIR MODE: RISE + FALL</field></block></value>
                  <next><block type="variables_set" id="9022"><field name="VAR" id="a3">Analysis Card 3</field><value name="VALUE"><block type="text" id="9023"><field name="TEXT">ENTRY CHECK: ANALYSING</field></block></value></block>
                  </next></block>
                </next></block>
              </next></block>
            </next></block>
          </next></block>
        </next></block>
    </statement>
  </block>
  <block type="before_purchase" id="9030" x="14" y="500">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="9100">
        <field name="PURCHASE_TYPE">CALL</field>
        <next>
          <block type="purchase" id="9101">
            <field name="PURCHASE_TYPE">PUT</field>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="9040" x="14" y="700">
    <statement name="AFTERPURCHASE_STACK">
      <block type="trade_again" id="9099"></block>
    </statement>
  </block>
</xml>
