<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="a1">Stake per side</variable>
    <variable id="a2">Duration (even ticks)</variable>
  </variables>
  <block type="trade_definition" id="trade_definition" deletable="false" x="0" y="0">
    <field name="MARKET_LIST">synthetic_indices</field>
    <field name="SUBMARKET_LIST">step_indices</field>
    <field name="SYMBOL_LIST">STP100</field>
    <field name="TRADETYPECAT">callput</field>
    <field name="TRADETYPE">risefall</field>
    <field name="TYPE">both</field>
    <field name="DURATIONUNIT">t</field>
    <field name="AMOUNT">1</field>
    <field name="DURATION">2</field>
    <field name="BARRIEROFFSET">0</field>
    <field name="CANDLEINTERVAL">60</field>
    <field name="RESTARTBUYSELL">TRUE</field>
    <field name="RESTARTONERROR">TRUE</field>
  </block>
  <block type="on_strategy_open" id="init" x="0" y="300">
    <statement name="STACK">
      <block type="variables_set" id="v1">
        <field name="VAR" id="a1">Stake per side</field>
        <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
        <next>
          <block type="variables_set" id="v2">
            <field name="VAR" id="a2">Duration (even ticks)</field>
            <value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="before">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase"><field name="PURCHASE_TYPE">RISE</field></block>
    </statement>
  </block>
  <block type="during_purchase" id="during">
    <statement name="DURINGPURCHASE_STACK">
      <block type="purchase"><field name="PURCHASE_TYPE">FALL</field></block>
    </statement>
  </block>
  <block type="after_purchase" id="after">
    <statement name="AFTERPURCHASE_STACK">
      <block type="trade_again"><field name="BOOL">TRUE</field></block>
    </statement>
  </block>
</xml>
