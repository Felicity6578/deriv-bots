<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable id="s">stake</variable>
    <variable id="sa">stake awal</variable>
    <variable id="m">Martingale</variable>
    <variable id="profit">total profit</variable>
    <variable id="seq">sequence</variable>
    <variable id="idx">index</variable>
    <variable id="tgt">target</variable>
    <variable id="t1">T1</variable>
    <variable id="prev">prev T1</variable>
    <variable id="opta">OPTION_A</variable>
    <variable id="cnt">count</variable>
    <variable id="pct">percent</variable>
    <variable id="ldl">last_digits_list</variable>
    <variable id="item">item</variable>
    <variable id="txt">text</variable>
    <variable id="txt1">text1</variable>
  </variables>
  <block type="trade" id="trade1" x="14" y="14">
    <statement name="SUBMARKET">
      <block type="market" id="mkt1">
        <field name="MARKET_LIST">volidx</field>
        <field name="SUBMARKET_LIST">continuous_indices</field>
        <field name="SYMBOL_LIST">R_100</field>
        <field name="TRADETYPECAT_LIST">digits</field>
        <field name="TRADETYPE_LIST">matches_differs</field>
        <field name="TYPE_LIST">differs</field>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <field name="RESTARTONERROR">TRUE</field>
        <value name="DURATION"><block type="math_number"><field name="NUM">1</field></block></value>
        <value name="AMOUNT"><block type="variables_get"><field name="VAR" id="s">stake</field></block></value>
        <value name="BARRIEROFFSET"><block type="math_number"><field name="NUM">8</field></block></value>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set"><field name="VAR" id="s">stake</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
        <next>
          <block type="variables_set"><field name="VAR" id="sa">stake awal</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set"><field name="VAR" id="m">Martingale</field><value name="VALUE"><block type="math_number"><field name="NUM">2.1</field></block></value>
                <next>
                  <block type="variables_set"><field name="VAR" id="profit">total profit</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                    <next>
                      <block type="variables_set"><field name="VAR" id="idx">index</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
                        <next>
                          <block type="variables_set"><field name="VAR" id="t1">T1</field><value name="VALUE"><block type="math_number"><field name="NUM">-1</field></block></value>
                            <next>
                              <block type="variables_set"><field name="VAR" id="prev">prev T1</field><value name="VALUE"><block type="math_number"><field name="NUM">-1</field></block></value>
                                <next>
                                  <block type="variables_set"><field name="VAR" id="opta">OPTION_A</field><value name="VALUE"><block type="logic_boolean"><field name="BOOL">FALSE</field></block></value>
                                    <next>
                                      <block type="variables_set"><field name="VAR" id="seq">sequence</field>
                                        <value name="VALUE">
                                          <block type="lists_create_with"><mutation items="10"></mutation>
                                            <value name="ADD0"><block type="math_number"><field name="NUM">8</field></block></value>
                                            <value name="ADD1"><block type="math_number"><field name="NUM">6</field></block></value>
                                            <value name="ADD2"><block type="math_number"><field name="NUM">3</field></block></value>
                                            <value name="ADD3"><block type="math_number"><field name="NUM">5</field></block></value>
                                            <value name="ADD4"><block type="math_number"><field name="NUM">4</field></block></value>
                                            <value name="ADD5"><block type="math_number"><field name="NUM">2</field></block></value>
                                            <value name="ADD6"><block type="math_number"><field name="NUM">7</field></block></value>
                                            <value name="ADD7"><block type="math_number"><field name="NUM">9</field></block></value>
                                            <value name="ADD8"><block type="math_number"><field name="NUM">0</field></block></value>
                                            <value name="ADD9"><block type="math_number"><field name="NUM">1</field></block></value>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="variables_set"><field name="VAR" id="tgt">target</field>
                                            <value name="VALUE"><block type="lists_getIndex"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="seq">sequence</field></block></value><value name="AT"><block type="variables_get"><field name="VAR" id="idx">index</field></block></value></block></value>
                                            <next>
                                              <block type="variables_set"><field name="VAR" id="txt">text</field><value name="VALUE"><block type="text"><field name="TEXT">BOT LOADED - Archie Fast V2 - Differs Only Fixed T1</field></block></value>
                                                <next>
                                                  <block type="notify"><field name="NOTIFICATION_TYPE">info</field><value name="MESSAGE"><block type="variables_get"><field name="VAR" id="txt">text</field></block></value></block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" x="400" y="14">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_repeat"><field name="TIMES">TRUE</field>
        <statement name="DO">
          <block type="variables_set"><field name="VAR" id="ldl">last_digits_list</field><value name="VALUE"><block type="last_digit_list"><value name="AMOUNT"><block type="math_number"><field name="NUM">100</field></block></value></block></value>
            <next>
              <block type="variables_set"><field name="VAR" id="t1">T1</field><value name="VALUE"><block type="lists_getIndex"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="ldl">last_digits_list</field></block></value><value name="AT"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
                <next>
                  <block type="controls_if"><mutation else="1"></mutation>
                    <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="t1">T1</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="prev">prev T1</field></block></value></block></value>
                    <statement name="DO0">
                      <block type="variables_set"><field name="VAR" id="txt">text</field><value name="VALUE"><block type="text_join"><mutation items="4"></mutation><value name="ADD0"><block type="text"><field name="TEXT">Waiting new T1, still=</field></block></value><value name="ADD1"><block type="variables_get"><field name="VAR" id="t1">T1</field></block></value><value name="ADD2"><block type="text"><field name="TEXT"> prev=</field></block></value><value name="ADD3"><block type="variables_get"><field name="VAR" id="prev">prev T1</field></block></value></block></value>
                        <next>
                          <block type="notify"><field name="NOTIFICATION_TYPE">info</field><value name="MESSAGE"><block type="variables_get"><field name="VAR" id="txt">text</field></block></value>
                            <next>
                              <block type="run_after"><value name="SECONDS"><block type="math_number"><field name="NUM">1</field></block></value></block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <block type="variables_set"><field name="VAR" id="cnt">count</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                        <next>
                          <block type="controls_forEach"><field name="VAR" id="item">item</field><value name="LIST"><block type="variables_get"><field name="VAR" id="ldl">last_digits_list</field></block></value>
                            <statement name="DO"><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="item">item</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="tgt">target</field></block></value></block></value><statement name="DO0"><block type="variables_set"><field name="VAR" id="cnt">count</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="variables_get"><field name="VAR" id="cnt">count</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value></block></statement></block></statement>
                            <next>
                              <block type="variables_set"><field name="VAR" id="pct">percent</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">DIVIDE</field><value name="A"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="cnt">count</field></block></value><value name="B"><block type="math_number"><field name="NUM">100</field></block></value></block></value><value name="B"><block type="math_number"><field name="NUM">100</field></block></value></block></value>
                                <next>
                                  <block type="controls_if"><mutation else="1"></mutation>
                                    <value name="IF0"><block type="logic_operation"><field name="OP">AND</field><value name="A"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="t1">T1</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="tgt">target</field></block></value></block></value><value name="B"><block type="logic_compare"><field name="OP">LTE</field><value name="A"><block type="variables_get"><field name="VAR" id="pct">percent</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value></block></value>
                                    <statement name="DO0">
                                      <block type="variables_set"><field name="VAR" id="opta">OPTION_A</field><value name="VALUE"><block type="logic_boolean"><field name="BOOL">TRUE</field></block></value>
                                        <next>
                                          <block type="controls_break"></block>
                                        </next>
                                      </block>
                                    </statement>
                                    <statement name="ELSE">
                                      <block type="controls_if"><mutation else="1"></mutation>
                                        <value name="IF0"><block type="logic_operation"><field name="OP">AND</field><value name="A"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="t1">T1</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="tgt">target</field></block></value></block></value><value name="B"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_get"><field name="VAR" id="pct">percent</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value></block></value>
                                        <statement name="DO0">
                                          <block type="variables_set"><field name="VAR" id="txt">text</field><value name="VALUE"><block type="text_join"><mutation items="6"></mutation><value name="ADD0"><block type="text"><field name="TEXT">SKIP Target=</field></block></value><value name="ADD1"><block type="variables_get"><field name="VAR" id="tgt">target</field></block></value><value name="ADD2"><block type="text"><field name="TEXT"> T1=</field></block></value><value name="ADD3"><block type="variables_get"><field name="VAR" id="t1">T1</field></block></value><value name="ADD4"><block type="text"><field name="TEXT"> % Over 10 = </field></block></value><value name="ADD5"><block type="variables_get"><field name="VAR" id="pct">percent</field></block></value></block></value>
                                            <next>
                                              <block type="notify"><field name="NOTIFICATION_TYPE">warn</field><value name="MESSAGE"><block type="variables_get"><field name="VAR" id="txt">text</field></block></value>
                                                <next>
                                                  <block type="variables_set"><field name="VAR" id="idx">index</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="variables_get"><field name="VAR" id="idx">index</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
                                                    <next>
                                                      <block type="controls_if"><mutation else="1"></mutation>
                                                        <value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_get"><field name="VAR" id="idx">index</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value>
                                                        <statement name="DO0"><block type="variables_set"><field name="VAR" id="idx">index</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
                                                        <statement name="ELSE"></statement>
                                                        <next>
                                                          <block type="variables_set"><field name="VAR" id="tgt">target</field><value name="VALUE"><block type="lists_getIndex"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="seq">sequence</field></block></value><value name="AT"><block type="variables_get"><field name="VAR" id="idx">index</field></block></value></block></value></block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </statement>
                                        <statement name="ELSE">
                                          <block type="variables_set"><field name="VAR" id="txt">text</field><value name="VALUE"><block type="text_join"><mutation items="6"></mutation><value name="ADD0"><block type="text"><field name="TEXT">Waiting Target=</field></block></value><value name="ADD1"><block type="variables_get"><field name="VAR" id="tgt">target</field></block></value><value name="ADD2"><block type="text"><field name="TEXT"> T1=</field></block></value><value name="ADD3"><block type="variables_get"><field name="VAR" id="t1">T1</field></block></value><value name="ADD4"><block type="text"><field name="TEXT"> %=</field></block></value><value name="ADD5"><block type="variables_get"><field name="VAR" id="pct">percent</field></block></value></block></value>
                                            <next>
                                              <block type="notify"><field name="NOTIFICATION_TYPE">info</field><value name="MESSAGE"><block type="variables_get"><field name="VAR" id="txt">text</field></block></value>
                                                <next>
                                                  <block type="run_after"><value name="SECONDS"><block type="math_number"><field name="NUM">1</field></block></value></block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </statement>
                                      </block>
                                    </statement>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if"><mutation else="1"></mutation>
            <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="opta">OPTION_A</field></block></value><value name="B"><block type="logic_boolean"><field name="BOOL">TRUE</field></block></value></block></value>
            <statement name="DO0">
              <block type="variables_set"><field name="VAR" id="txt1">text1</field><value name="VALUE"><block type="text_join"><mutation items="4"></mutation><value name="ADD0"><block type="text"><field name="TEXT">Buy At Last Digit </field></block></value><value name="ADD1"><block type="variables_get"><field name="VAR" id="t1">T1</field></block></value><value name="ADD2"><block type="text"><field name="TEXT"> Target=</field></block></value><value name="ADD3"><block type="variables_get"><field name="VAR" id="tgt">target</field></block></value></block></value>
                <next>
                  <block type="notify"><field name="NOTIFICATION_TYPE">info</field><value name="MESSAGE"><block type="variables_get"><field name="VAR" id="txt1">text1</field></block></value>
                    <next>
                      <block type="notify"><field name="NOTIFICATION_TYPE">info</field><value name="MESSAGE"><block type="text"><field name="TEXT">BUY DIFFERS</field></block></value></block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="variables_set"><field name="VAR" id="txt1">text1</field><value name="VALUE"><block type="text"><field name="TEXT">LOOP EXIT WITHOUT OPTION - NO TRADE</field></block></value>
                <next>
                  <block type="notify"><field name="NOTIFICATION_TYPE">warn</field><value name="MESSAGE"><block type="variables_get"><field name="VAR" id="txt1">text1</field></block></value></block>
                </next>
              </block>
            </statement>
            <next>
              <block type="purchase"><field name="PURCHASE_TYPE">DIGITDIFF</field><value name="BARRIEROFFSET"><block type="variables_get"><field name="VAR" id="tgt">target</field></block></value></block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" x="400" y="900">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if"><mutation else="1"></mutation>
        <value name="IF0"><block type="contract_check_result"><field name="CHECK_RESULT">loss</field></block></value>
        <statement name="DO0">
          <block type="variables_set"><field name="VAR" id="profit">total profit</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MINUS</field><value name="A"><block type="variables_get"><field name="VAR" id="profit">total profit</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="s">stake</field></block></value></block></value>
            <next>
              <block type="variables_set"><field name="VAR" id="s">stake</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="s">stake</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="m">Martingale</field></block></value></block></value>
                <next>
                  <block type="variables_set"><field name="VAR" id="txt">text</field><value name="VALUE"><block type="text"><field name="TEXT">LOSS - Martingale up</field></block></value>
                    <next>
                      <block type="notify"><field name="NOTIFICATION_TYPE">warn</field><value name="MESSAGE"><block type="variables_get"><field name="VAR" id="txt">text</field></block></value></block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set"><field name="VAR" id="profit">total profit</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="variables_get"><field name="VAR" id="profit">total profit</field></block></value><value name="B"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="s">stake</field></block></value><value name="B"><block type="math_number"><field name="NUM">0.11</field></block></value></block></value></block></value>
            <next>
              <block type="variables_set"><field name="VAR" id="s">stake</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="sa">stake awal</field></block></value>
                <next>
                  <block type="variables_set"><field name="VAR" id="txt">text</field><value name="VALUE"><block type="text"><field name="TEXT">WIN - Reset stake</field></block></value>
                    <next>
                      <block type="notify"><field name="NOTIFICATION_TYPE">success</field><value name="MESSAGE"><block type="variables_get"><field name="VAR" id="txt">text</field></block></value></block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="variables_set"><field name="VAR" id="opta">OPTION_A</field><value name="VALUE"><block type="logic_boolean"><field name="BOOL">FALSE</field></block></value>
            <next>
              <block type="variables_set"><field name="VAR" id="idx">index</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="variables_get"><field name="VAR" id="idx">index</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
                <next>
                  <block type="controls_if"><mutation else="1"></mutation>
                    <value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_get"><field name="VAR" id="idx">index</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value>
                    <statement name="DO0"><block type="variables_set"><field name="VAR" id="idx">index</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
                    <statement name="ELSE"></statement>
                    <next>
                      <block type="variables_set"><field name="VAR" id="tgt">target</field><value name="VALUE"><block type="lists_getIndex"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="seq">sequence</field></block></value><value name="AT"><block type="variables_get"><field name="VAR" id="idx">index</field></block></value></block></value>
                        <next>
                          <block type="variables_set"><field name="VAR" id="prev">prev T1</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="t1">T1</field></block></value>
                            <next>
                              <block type="variables_set"><field name="VAR" id="txt">text</field><value name="VALUE"><block type="text_join"><mutation items="4"></mutation><value name="ADD0"><block type="text"><field name="TEXT">NEXT TARGET = </field></block></value><value name="ADD1"><block type="variables_get"><field name="VAR" id="tgt">target</field></block></value><value name="ADD2"><block type="text"><field name="TEXT"> Profit=</field></block></value><value name="ADD3"><block type="variables_get"><field name="VAR" id="profit">total profit</field></block></value></block></value>
                                <next>
                                  <block type="notify"><field name="NOTIFICATION_TYPE">info</field><value name="MESSAGE"><block type="variables_get"><field name="VAR" id="txt">text</field></block></value>
                                    <next>
                                      <block type="trade_again"></block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
