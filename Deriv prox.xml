<xml xmlns="https://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable id="stake">stake</variable>
    <variable id="base_stake">base_stake</variable>
    <variable id="marti_stake">marti_stake</variable>
    <variable id="loss_streak">loss_streak</variable>
    <variable id="is_even">is_even</variable>
    <variable id="total_profit">total_profit</variable>
    <variable id="tp">tp</variable>
    <variable id="sl">sl</variable>
  </variables>
  <block type="trade_definition" id="trade_def" deletable="false" x="0" y="0">
    <field name="MARKET_LIST">synthetic_indices</field>
    <field name="SUBMARKET_LIST">continuous_indices</field>
    <field name="SYMBOL_LIST">R_100</field>
    <field name="TRADETYPECAT">digits</field>
    <field name="TRADETYPE">evenodd</field>
    <field name="TYPE">both</field>
    <field name="CANDLEINTERVAL">60</field>
    <field name="RESTART_BUY_SELL">true</field>
    <field name="RESTART_ON_ERROR">true</field>
    <field name="DURATIONUNIT">t</field>
    <field name="AMOUNT">stake</field>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init1">
        <field name="VAR" id="base_stake">base_stake</field>
        <value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value>
        <next>
          <block type="variables_set" id="init2">
            <field name="VAR" id="marti_stake">marti_stake</field>
            <value name="VALUE"><block type="math_number"><field name="NUM">2.5</field></block></value>
            <next>
              <block type="variables_set" id="init3">
                <field name="VAR" id="tp">tp</field>
                <value name="VALUE"><block type="math_number"><field name="NUM">10</field></block></value>
                <next>
                  <block type="variables_set" id="init4">
                    <field name="VAR" id="sl">sl</field>
                    <value name="VALUE"><block type="math_number"><field name="NUM">5</field></block></value>
                    <next>
                      <block type="variables_set" id="init5">
                        <field name="VAR" id="stake">stake</field>
                        <value name="VALUE"><block type="variables_get"><field name="VAR" id="base_stake">base_stake</field></block></value>
                        <next>
                          <block type="variables_set" id="init6">
                            <field name="VAR" id="loss_streak">loss_streak</field>
                            <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                            <next>
                              <block type="variables_set" id="init7">
                                <field name="VAR" id="total_profit">total_profit</field>
                                <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                                <next>
                                  <block type="variables_set" id="init8">
                                    <field name="VAR" id="is_even">is_even</field>
                                    <value name="VALUE"><block type="logic_boolean"><field name="BOOL">TRUE</field></block></value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="before1" x="0" y="400">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="bp1">
        <value name="IF0"><block type="variables_get" id="bp2"><field name="VAR" id="is_even">is_even</field></block></value>
        <statement name="DO0"><block type="purchase" id="bp3"><field name="PURCHASE_TYPE">DIGITEVEN</field></block></statement>
        <statement name="ELSE"><block type="purchase" id="bp4"><field name="PURCHASE_TYPE">DIGITODD</field></block></statement>
      </block>
    </statement>
  </block>
  <block type="during_purchase" id="during1" x="0" y="700">
    <statement name="DURINGPURCHASE_STACK">
      <block type="variables_set" id="d1">
        <field name="VAR" id="total_profit">total_profit</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="d2"><field name="OP">ADD</field>
            <value name="A"><block type="variables_get" id="d3"><field name="VAR" id="total_profit">total_profit</field></block></value>
            <value name="B"><block type="contract_details" id="d4"><field name="DETAIL">profit</field></block></value>
          </block>
        </value>
        <next>
          <block type="controls_if" id="d5">
            <value name="IF0">
              <block type="logic_compare" id="d6"><field name="OP">EQ</field>
                <value name="A"><block type="contract_details" id="d7"><field name="DETAIL">isWin</field></block></value>
                <value name="B"><block type="logic_boolean" id="d8"><field name="BOOL">TRUE</field></block></value>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="d9">
                <field name="VAR" id="loss_streak">loss_streak</field>
                <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                <next>
                  <block type="variables_set" id="d10">
                    <field name="VAR" id="stake">stake</field>
                    <value name="VALUE"><block type="variables_get" id="d11"><field name="VAR" id="base_stake">base_stake</field></block></value>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="variables_set" id="d12">
                <field name="VAR" id="loss_streak">loss_streak</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="d13"><field name="OP">ADD</field>
                    <value name="A"><block type="variables_get" id="d14"><field name="VAR" id="loss_streak">loss_streak</field></block></value>
                    <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="d15">
                    <value name="IF0">
                      <block type="logic_compare" id="d16"><field name="OP">EQ</field>
                        <value name="A"><block type="variables_get" id="d17"><field name="VAR" id="loss_streak">loss_streak</field></block></value>
                        <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="d18">
                        <field name="VAR" id="stake">stake</field>
                        <value name="VALUE"><block type="variables_get" id="d19"><field name="VAR" id="marti_stake">marti_stake</field></block></value>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if" id="d20">
                        <value name="IF0">
                          <block type="logic_compare" id="d21"><field name="OP">GTE</field>
                            <value name="A"><block type="variables_get" id="d22"><field name="VAR" id="loss_streak">loss_streak</field></block></value>
                            <value name="B"><block type="math_number"><field name="NUM">2</field></block></value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="d23">
                            <field name="VAR" id="is_even">is_even</field>
                            <value name="VALUE">
                              <block type="logic_negate" id="d24">
                                <value name="BOOL"><block type="variables_get" id="d25"><field name="VAR" id="is_even">is_even</field></block></value>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="d26">
                                <field name="VAR" id="loss_streak">loss_streak</field>
                                <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                                <next>
                                  <block type="variables_set" id="d27">
                                    <field name="VAR" id="stake">stake</field>
                                    <value name="VALUE"><block type="variables_get" id="d28"><field name="VAR" id="base_stake">base_stake</field></block></value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="after1" x="0" y="1200">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="a1">
        <value name="IF0">
          <block type="logic_operation" id="a2"><field name="OP">OR</field>
            <value name="A">
              <block type="logic_compare" id="a3"><field name="OP">GTE</field>
                <value name="A"><block type="variables_get" id="a4"><field name="VAR" id="total_profit">total_profit</field></block></value>
                <value name="B"><block type="variables_get" id="a5"><field name="VAR" id="tp">tp</field></block></value>
              </block>
            </value>
            <value name="B">
              <block type="logic_compare" id="a6"><field name="OP">LTE</field>
                <value name="A"><block type="variables_get" id="a7"><field name="VAR" id="total_profit">total_profit</field></block></value>
                <value name="B">
                  <block type="math_arithmetic" id="a8"><field name="OP">MULTIPLY</field>
                    <value name="A"><block type="variables_get" id="a9"><field name="VAR" id="sl">sl</field></block></value>
                    <value name="B"><block type="math_number"><field name="NUM">-1</field></block></value>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="notify" id="a10"><value name="INPUT"><block type="text" id="a11"><field name="TEXT">TP/SL Hit - Bot Stopped</field></block></value></block>
        </statement>
        <statement name="ELSE"><block type="trade_again" id="a12"></block></statement>
      </block>
    </statement>
  </block>
</xml>
