<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="seq">sequence</variable>
    <variable id="idx">index</variable>
    <variable id="tgt">target</variable>
    <variable id="t1">T1</variable>
    <variable id="optA">OPTION_A</variable>
    <variable id="stake">stake</variable>
    <variable id="profit">total_profit</variable>
  </variables>
  <block type="trade" deletable="false" movable="false">
    <field name="MARKET">R_100</field>
    <field name="TRADETYPE">DIGITDIFF</field>
    <field name="BARRIEROFFSET">8</field>
    <field name="DURATION">5</field>
    <field name="DURATION_UNIT">t</field>
    <field name="STAKE">1</field>
    <field name="CURRENCY">USD</field>
  </block>
  <block type="on_strategy">
    <statement name="ON_STRATEGY_STACK">
      <block type="variables_set">
        <field name="VAR" id="seq">sequence</field>
        <value name="VALUE">
          <block type="lists_create_with">
            <mutation items="10"></mutation>
            <value name="ADD0"><block type="math_number"><field name="NUM">8</field></block></value>
            <value name="ADD1"><block type="math_number"><field name="NUM">6</field></block></value>
            <value name="ADD2"><block type="math_number"><field name="NUM">3</field></block></value>
            <value name="ADD3"><block type="math_number"><field name="NUM">5</field></block></value>
            <value name="ADD4"><block type="math_number"><field name="NUM">4</field></block></value>
            <value name="ADD5"><block type="math_number"><field name="NUM">2</field></block></value>
            <value name="ADD6"><block type="math_number"><field name="NUM">7</field></block></value>
            <value name="ADD7"><block type="math_number"><field name="NUM">9</field></block></value>
            <value name="ADD8"><block type="math_number"><field name="NUM">0</field></block></value>
            <value name="ADD9"><block type="math_number"><field name="NUM">1</field></block></value>
          </block>
        </value>
        <next>
          <block type="variables_set">
            <field name="VAR" id="idx">index</field>
            <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set">
                <field name="VAR" id="tgt">target</field>
                <value name="VALUE">
                  <block type="lists_getIndex">
                    <mutation statement="false" at="true"></mutation>
                    <field name="MODE">GET</field>
                    <field name="WHERE">FROM_START</field>
                    <value name="VALUE"><block type="variables_get"><field name="VAR" id="seq">sequence</field></block></value>
                    <value name="AT"><block type="variables_get"><field name="VAR" id="idx">index</field></block></value>
                  </block>
                </value>
                <next>
                  <block type="variables_set">
                    <field name="VAR" id="stake">stake</field>
                    <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
                    <next>
                      <block type="variables_set">
                        <field name="VAR" id="profit">total_profit</field>
                        <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                        <next>
                          <block type="notify">
                            <field name="NOTIFY_TYPE">info</field>
                            <value name="MESSAGE"><block type="text"><field name="TEXT">BOT LOADED - FIRST TARGET 8</field></block></value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="on_tick">
    <statement name="ON_TICK_STACK">
      <block type="variables_set">
        <field name="VAR" id="t1">T1</field>
        <value name="VALUE"><block type="tick_analysis"><field name="TICK_ANALYSIS">LAST_DIGIT</field></block></value>
        <next>
          <block type="controls_if">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_operation">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="logic_compare"><field name="OP">EQ</field>
                    <value name="A"><block type="variables_get"><field name="VAR" id="t1">T1</field></block></value>
                    <value name="B"><block type="variables_get"><field name="VAR" id="tgt">target</field></block></value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare"><field name="OP">LTE</field>
                    <value name="A"><block type="tick_analysis"><field name="TICK_ANALYSIS">LAST_DIGIT_PERCENT</field></block></value>
                    <value name="B"><block type="math_number"><field name="NUM">10</field></block></value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set">
                <field name="VAR" id="optA">OPTION_A</field>
                <value name="VALUE"><block type="logic_boolean"><field name="BOOL">TRUE</field></block></value>
                <next>
                  <block type="notify">
                    <field name="NOTIFY_TYPE">info</field>
                    <value name="MESSAGE"><block type="text"><field name="TEXT">BUY DIFFERS</field></block></value>
                    <next>
                      <block type="trade_parameters">
                        <field name="MARKET">R_100</field>
                        <field name="TRADETYPE">DIGITDIFF</field>
                        <value name="BARRIEROFFSET">
                          <block type="variables_get"><field name="VAR" id="tgt">target</field></block>
                        </value>
                        <value name="STAKE">
                          <block type="variables_get"><field name="VAR" id="stake">stake</field></block>
                        </value>
                        <value name="DURATION"><block type="math_number"><field name="NUM">5</field></block></value>
                      </block>
                      <next>
                        <block type="purchase">
                          <field name="PURCHASE_TYPE">DIGITDIFF</field>
                        </block>
                      </next>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="notify">
                <field name="NOTIFY_TYPE">info</field>
                <value name="MESSAGE"><block type="text"><field name="TEXT">LOOP EXIT WITHOUT OPTION - NO TRADE</field></block></value>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="on_trade_finish">
    <statement name="ON_TRADE_FINISH_STACK">
      <block type="variables_set">
        <field name="VAR" id="idx">index</field>
        <value name="VALUE">
          <block type="math_arithmetic"><field name="OP">ADD</field>
            <value name="A"><block type="variables_get"><field name="VAR" id="idx">index</field></block></value>
            <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
          </block>
        </value>
        <next>
          <block type="controls_if">
            <value name="IF0">
              <block type="logic_compare"><field name="OP">GT</field>
                <value name="A"><block type="variables_get"><field name="VAR" id="idx">index</field></block></value>
                <value name="B"><block type="math_number"><field name="NUM">10</field></block></value>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set">
                <field name="VAR" id="idx">index</field>
                <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
              </block>
            </statement>
            <next>
              <block type="variables_set">
                <field name="VAR" id="tgt">target</field>
                <value name="VALUE">
                  <block type="lists_getIndex">
                    <mutation statement="false" at="true"></mutation>
                    <field name="MODE">GET</field>
                    <field name="WHERE">FROM_START</field>
                    <value name="VALUE"><block type="variables_get"><field name="VAR" id="seq">sequence</field></block></value>
                    <value name="AT"><block type="variables_get"><field name="VAR" id="idx">index</field></block></value>
                  </block>
                </value>
                <next>
                  <block type="notify">
                    <field name="NOTIFY_TYPE">info</field>
                    <value name="MESSAGE"><block type="text"><field name="TEXT">NEXT TARGET UPDATED</field></block></value>
                    <next>
                      <block type="trade_again"></block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
