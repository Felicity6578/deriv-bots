<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
<variables>
<variable type="" id="s">stake</variable>
<variable type="" id="b">base_stake</variable>
<variable type="' id="m">marti_stake</variable>
<variable type="' id="l">loss_streak</variable>
